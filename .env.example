# Shared HMAC secret. Same value on Hermes (container environment)
# and on the supervisor compose .env. Never commit a real token.
COMPUTER_SUPERVISOR_TOKEN=
# How Hermes reaches the supervisor (Docker DNS on the shared network).
COMPUTER_SUPERVISOR_URL=http://hermes-computer-supervisor:9376
# Supervisor-only:
# COMPUTER_NETWORK=hermes-computers
# COMPUTER_DATA_DIR=/var/lib/hermes-computer
# COMPUTER_IDLE_S=1800
# COMPUTER_IMAGE=ghcr.io/tomlis20/hermes-computer:v0.1.0
